<?xml version="1.0" encoding="UTF-8"?>
<schema name="memorylane" version="1.6">
  
  <!-- Field Types -->
  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  
  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <similarity class="solr.BM25SimilarityFactory">
      <float name="k1">1.2</float>
      <float name="b">0.75</float>
    </similarity>
  </fieldType>
  
  <fieldType name="knn_vector_384" class="solr.DenseVectorField" 
             vectorDimension="384" vectorEncoding="FLOAT32" similarityFunction="cosine"/>
  
  <!-- Fields -->
  <field name="id" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="webpage_id" type="string" indexed="true" stored="true"/>
  <field name="url" type="string" indexed="true" stored="true"/>
  <field name="title" type="text_general" indexed="true" stored="true"/>
  <field name="domain" type="string" indexed="true" stored="true"/>
  <field name="text" type="text_general" indexed="true" stored="true"/>
  <field name="chunk_id" type="pint" indexed="true" stored="true"/>
  <field name="total_chunks" type="pint" indexed="true" stored="true"/>
  <field name="timestamp" type="string" indexed="true" stored="true" docValues="true"/>
  <field name="embedding" type="knn_vector_384" indexed="true" stored="true"/>
  
  <!-- Required by Solr -->
  <field name="_version_" type="plong" indexed="false" stored="false"/>
  
  <uniqueKey>id</uniqueKey>
  
</schema>
