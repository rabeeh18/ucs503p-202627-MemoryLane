# Solr
SOLR_URL=http://localhost:8983/solr/memorylane

# Retrieval
DEFAULT_TOP_K=10
DEFAULT_CANDIDATE_POOL=50
RRF_K=60
BM25_WEIGHT=1.0
VECTOR_WEIGHT=1.0
PAGE_SECOND_CHUNK_WEIGHT=0.3

# Chunking
TARGET_MIN_WORDS=300
TARGET_MAX_WORDS=500

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=

# API
API_HOST=0.0.0.0
API_PORT=8000
