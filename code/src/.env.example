# Solr
SOLR_URL=http://localhost:8983/solr/memorylane_v2

# Retrieval
DEFAULT_TOP_K=10
DEFAULT_CANDIDATE_POOL=50
RRF_K=60
BM25_WEIGHT=1.0
VECTOR_WEIGHT=1.0
PAGE_SECOND_CHUNK_WEIGHT=0.3
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=20

# Chunking
CHUNK_MAX_WORDS=150
CHUNK_MIN_WORDS=40
CHUNK_OVERLAP_WORDS=30

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Quoted to keep the trailing space. For all-MiniLM-L6-v2 set it empty: EMBEDDING_QUERY_PREFIX=
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Cognito (backend). Pool and app-client ids are public identifiers, not secrets.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_86B3TDFF4
COGNITO_APP_CLIENT_ID=2peosqda8lrs1q4ud0bi0etklq

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# API
CORS_ORIGINS=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000
