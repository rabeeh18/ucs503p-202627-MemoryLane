# Copy to .env (next to docker-compose.yml) and fill in. .env is gitignored.

# Domain (Caddy serves https://$DOMAIN and redirects www.$DOMAIN to it)
DOMAIN=memorylane.site
CORS_ORIGINS=https://memorylane.site,http://localhost:5173

# Solr. docker-compose.yml sets SOLR_URL for the backend container itself;
# this value is for running the API or scripts directly on a machine.
SOLR_URL=http://localhost:8983/solr/memorylane_v2
SOLR_HEAP=1g
# Docker volume holding Solr's data (the old stack's volume, so the old core is kept)
SOLR_VOLUME=src_solr_data

# Retrieval
DEFAULT_TOP_K=10
DEFAULT_CANDIDATE_POOL=50
RRF_K=60
BM25_WEIGHT=1.0
VECTOR_WEIGHT=1.0
PAGE_SECOND_CHUNK_WEIGHT=0.3
# Pages with no keyword match must reach this cosine similarity to be shown
MIN_VECTOR_SIMILARITY=0.55
# Keyword matches holding at least this share of the query's words are kept whatever
# their similarity; ones holding fewer need MIN_VECTOR_SIMILARITY like any other page
KEYWORD_FULL_MATCH=0.75
# Rank pages from a site, time or URL named in the query higher
QUERY_INTENT_ENABLED=true
INTENT_WEIGHT=1.0

# Library map
MAP_MAX_PAGES=2000
MAP_MIN_PAGES=10
# Pages less similar than this to their topic's centre are left unclustered
MAP_OUTLIER_SIMILARITY=0.35
# Topics whose centres are at least this similar get a dashed link
MAP_CROSS_TOPIC_SIMILARITY=0.65
MAP_CACHE_USERS=50
MAP_CACHE_TTL_SECONDS=600
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=20

# Chunking
CHUNK_MAX_WORDS=150
CHUNK_MIN_WORDS=40
CHUNK_OVERLAP_WORDS=30

# Saved pages per account (saving more is refused; updates still work)
MAX_PAGES_PER_USER=5000

# Problem reports ("Report a problem"). Stored in REPORTS_DB, emailed over SMTP
# (STARTTLS on 587, or TLS on 465). Leave SMTP_HOST empty to store them without
# sending. For Amazon SES: verify REPORTS_FROM and REPORTS_TO in the SES console
# (sandbox is fine when you only email yourself), create SMTP credentials there,
# and use email-smtp.<region>.amazonaws.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORTS_FROM=
REPORTS_TO=
# REPORTS_DB=data/reports.db   (the Docker image uses /data/reports.db on the accounts volume)

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Quoted to keep the trailing space. For all-MiniLM-L6-v2 set it empty: EMBEDDING_QUERY_PREFIX=
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Gemini (optional; summaries are disabled when the key is empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Cognito (backend). Pool and app-client ids are public identifiers, not secrets.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_86B3TDFF4
COGNITO_APP_CLIENT_ID=2peosqda8lrs1q4ud0bi0etklq
# Google and email sign-ins for the same verified email share one library. The API asks
# this domain for a sign-in's email; it defaults to VITE_COGNITO_DOMAIN, empty turns it off.
# COGNITO_DOMAIN=
# ACCOUNTS_DB=data/accounts.db   (the Docker image uses /data/accounts.db on the accounts volume)

# Frontend build (Vite; baked into the static files by the caddy image).
# For local development (npm run dev) use http://localhost:5173/auth/callback and http://localhost:5173/
VITE_API_BASE=/api
VITE_COGNITO_DOMAIN=https://ap-south-186b3tdff4.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=2peosqda8lrs1q4ud0bi0etklq
VITE_REDIRECT_URI=https://memorylane.site/auth/callback
VITE_LOGOUT_URI=https://memorylane.site/

# Only used when running uvicorn directly (not in Docker)
API_HOST=0.0.0.0
API_PORT=8000
