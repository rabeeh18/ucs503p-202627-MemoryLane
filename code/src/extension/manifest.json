{
  "manifest_version": 3,
  "name": "MemoryLane",
  "version": "2.1.0",
  "description": "Save pages as you browse and find them later by meaning.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://memorylane.site/*",
    "https://ap-south-186b3tdff4.auth.ap-south-1.amazoncognito.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://memorylane.site/*"
      ],
      "js": [
        "site_marker.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MemoryLane"
  },
  "options_page": "options.html",
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Search your saved pages"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
